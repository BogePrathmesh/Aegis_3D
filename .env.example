# AEGIS-3D Email Notification Configuration (Gmail SMTP)
#
# Minimal Setup Steps:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate an App Password for 'Mail':
#    https://myaccount.google.com/apppasswords
# 3. Copy the 16-character generated password and paste it into GMAIL_APP_PASSWORD below.
# 4. Copy this file to 'backend/.env' and populate your credentials.
#
# NOTE: Never commit '.env' containing your real credentials.

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_RECIPIENT=aimhighpa@gmail.com
